# OSINT Platform - API Keys Configuration
# Sign up for free API keys at each service's website

# 1. VirusTotal - https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_key_here

# 2. Shodan - https://account.shodan.io/register
SHODAN_API_KEY=your_key_here

# 3. IPinfo - https://ipinfo.io/signup
IPINFO_API_KEY=your_key_here

# 4. AbuseIPDB - https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_key_here

# 5. URLScan.io - https://urlscan.io/user/signup
URLSCAN_API_KEY=your_key_here

# 6. AlienVault OTX - https://otx.alienvault.com/
ALIENVAULT_API_KEY=your_key_here

# 7. GreyNoise - https://www.greynoise.io/
GREYNOISE_API_KEY=your_key_here

# 8. HackerTarget - No key needed (free public API)

# 9. ViewDNS - https://viewdns.info/api/
VIEWDNS_API_KEY=your_key_here

# 10. DNSdumpster - https://dnsdumpster.com/
DNSDUMPSTER_API_KEY=your_key_here

# 11. ipapi.co - No key needed (free public API)

# 12. LeakIX - https://leakix.net/
LEAKIX_API_KEY=your_key_here

# 13. Pulsedive - https://pulsedive.com/
PULSEDIVE_API_KEY=your_key_here

# Server Port
PORT=3000
