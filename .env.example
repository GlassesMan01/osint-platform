# OSINT Platform - API Keys Configuration
# Sign up for free API keys at each service's website

# 1. VirusTotal - https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_key_here

# 2. Shodan - https://account.shodan.io/register
SHODAN_API_KEY=your_key_here

# 3. SecurityTrails - https://securitytrails.com/app/signup
SECURITYTRAILS_API_KEY=your_key_here

# 4. IPinfo - https://ipinfo.io/signup
IPINFO_API_KEY=your_key_here

# 5. AbuseIPDB - https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_key_here

# 6. URLScan.io - https://urlscan.io/user/signup
URLSCAN_API_KEY=your_key_here

# 7. WhoisXML API - https://whoisxmlapi.com/
WHOISXML_API_KEY=your_key_here

# 8. AlienVault OTX - https://otx.alienvault.com/
ALIENVAULT_API_KEY=your_key_here

# 9. GreyNoise - https://www.greynoise.io/
GREYNOISE_API_KEY=your_key_here

# 10. Hunter.io - https://hunter.io/users/sign_up
HUNTER_API_KEY=your_key_here

# Server Port
PORT=3000
